      "minHeight": 48,
      "text": {
        "color": "$ui-ink",
        "size": 18.4,
        "weight": "700",
        "align": "center"
      },
      "hovered": {
        "background": "#ffe08f"
      },
      "focusVisible": {
        "focusRing": {
          "width": 3,
          "color": "$ui-accent",
          "offset": 2
        }
      }
    },
    ".ghost": {
      "background": "#00000000",
      "border": {
        "width": 1,
        "color": "$ui-line",
        "style": "solid"
      },
      "radius": 12,
