        "size": 16,
        "align": "center"
      },
      "hovered": {
        "background": "$ui-hover",
        "border": {
          "color": "$ui-accent"
        }
      },
      "focusVisible": {
        "focusRing": {
          "width": 3,
          "color": "$ui-accent",
          "offset": 2
        }
