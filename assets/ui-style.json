      "padding": {
        "top": 2,
        "end": 10,
        "bottom": 2,
        "start": 10
      }
    },
    ".badge-ranked": {
      "border": {
        "width": 1,
        "color": "$ui-accent",
        "style": "solid"
      },
      "radius": 999,
      "padding": {
        "top": 2,
        "end": 10,
        "bottom": 2,
        "start": 10
      }
    },
    ".big": {
      "background": "$ui-accent",
      "border": {
        "width": 1,
        "color": "$ui-line",
        "style": "solid"
      },
      "radius": 12,
      "padding": {
        "top": 14,
        "end": 22,
        "bottom": 14,
        "start": 22
